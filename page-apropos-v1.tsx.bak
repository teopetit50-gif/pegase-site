import type { Metadata } from "next";
import Link from "next/link";
import PageShell from "@/components/PageShell";
import PageMotion from "@/components/PageMotion";
import Fondu from "@/components/Fondu";
import Equipe from "@/components/apropos/Equipe";
import Quand from "@/components/apropos/Quand";
import Spotlight from "@/components/apropos/Spotlight";

/* ══════════════════════════════════════════════════════════════════════
   /contact — page À PROPOS, architecture hyperstack.studio/a-propos
   (30/07/2026, Teo : « exactement la même page, sauf le code couleur »)

   Les neuf sections de la référence, dans son ordre exact :
     1  hero sombre centré : titre 2 lignes, chapô, 4 tuiles chiffrées, 2 CTA
     2  « Notre vision »  → Pourquoi nous choisir ?      — 3 cartes
     3  « Nos valeurs »   → Comment nous travaillons     — 3 blocs alternés
     4  « Histoire »      → Comment tout a commencé      — prose + CTA
     5  « L'équipe »      → Qui sommes-nous ?            — grille portraits
     6  « Nos services »  → Ce que nous faisons          — SECTION SOMBRE
     7                      Quand faire appel ?          — 4 onglets + panneau
     8  « Cas clients »   → Ils ont transformé…          — carrousel citations
     9  CTA final en grand panneau arrondi sombre

   CODE COULEUR : celui de Pegase, pas celui d'hyperstack. Leur bleu nuit
   #1a1a5e devient le noir #000 du site, leur orange devient --gold #f78320,
   leurs surfaces #f5f5fa deviennent .monde-clair #f6f6f5 + .carte-claire.
   Aucune classe nouvelle : tout sort de la charte v2 existante.

   TEXTE : réécrit pour Pegase. La mise en page vient de la référence, la
   prose non — recopier leurs paragraphes serait de la contrefaçon, et leur
   contenu (100 clients, 10 personnes, no-code/data) ne décrit pas Pegase.

   PHOTOS : Unsplash bibliothèque gratuite, sourcées le 30/07 et créditées
   dans public/photos/CREDITS.txt (même convention que les fiches moteurs).

   La ROUTE reste /contact — header et footer y pointent, le libellé de nav
   est « À propos » depuis le 29/07. Les canaux de contact vivent en section
   #nous-joindre, conservés de la version précédente.
   ══════════════════════════════════════════════════════════════════════ */

export const metadata: Metadata = {
  title: "À propos — Pegase",
  description:
    "Qui est derrière Pegase : un desk d'automatisation établi en Guadeloupe, douze moteurs branchés sur les outils que les TPE utilisent déjà. Réponse sous 24 h ouvrées.",
};

/* ——— 1 · les quatre tuiles du hero ———
   Équivalent des « 30-70% / 5-10x / 100+ / IA ready » d'hyperstack. Chez eux
   ce sont des mesures de performance ; ici des faits du site, puisque Pegase
   n'a pas encore de résultats clients à publier. */
const CHIFFRES: { n: string; unite?: string; label: string }[] = [
  { n: "12", label: "moteurs au catalogue" },
  { n: "30", unite: "min", label: "d'audit, gratuit" },
  { n: "24", unite: "h", label: "ouvrées pour répondre" },
  { n: "2026", label: "conformité facture élec." },
];

/* ——— 2 · « Pourquoi nous choisir ? » — trois cartes ——— */
const RAISONS: { titre: string; texte: string }[] = [
  {
    titre: "Un seul moteur à la fois",
    texte:
      "On n'installe pas une suite. On installe celui que l'audit a désigné comme le plus coûteux, on attend qu'il ait fait ses preuves, et on parle du suivant seulement après. Vous ne payez jamais pour un chantier que vous n'avez pas encore rentabilisé.",
  },
  {
    titre: "Vos outils, pas les nôtres",
    texte:
      "Aucun logiciel à adopter, aucune migration, aucune formation d'équipe. Le raccordement se fait sur votre boîte mail, votre tableur, votre agenda et WhatsApp. Vos clients ne voient aucune différence, sinon qu'on leur répond plus vite.",
  },
  {
    titre: "Le chiffre avant le devis",
    texte:
      "L'audit précède toujours la proposition, il est gratuit, et il peut parfaitement conclure qu'aucun moteur n'est justifié chez vous. Un moteur qui ne rembourse pas son installation n'a pas à être installé.",
  },
];

/* ——— 3 · « Comment nous travaillons » — trois blocs alternés ——— */
const REGLES: { titre: string; texte: string; photo: string; alt: string }[] = [
  {
    titre: "On livre en jours, pas en trimestres",
    texte:
      "Un moteur se branche en quelques jours sur des outils qui existent déjà — c'est précisément pour cela qu'on ne construit pas de logiciel sur mesure. Vous voyez tourner la première relance, la première réponse client ou la première facture classée dans la semaine qui suit l'installation, pas au bout d'un cycle projet.",
    photo: "/photos/regle-execution.jpg",
    alt: "Un mécanicien au travail dans son atelier",
  },
  {
    titre: "Votre résultat est le seul indicateur",
    texte:
      "Un moteur installé qui ne change rien à votre trésorerie ou à votre charge de travail est un échec, quelle que soit sa qualité technique. On mesure ce qui rentre et ce qui vous est retiré des épaules, on le compare au chiffre de l'audit, et on ajuste tant que l'écart n'est pas comblé.",
    photo: "/photos/regle-resultat.jpg",
    alt: "Deux commerçants derrière le comptoir de leur établissement",
  },
  {
    titre: "Vous gardez la main, toujours",
    texte:
      "Vous fixez la frontière entre ce que le moteur traite seul et ce qui vous est transmis. Les premières semaines, tout vous est soumis avant envoi ; ensuite vous choisissez. Chaque message envoyé reste archivé et consultable, et si vous arrêtez un moteur vous récupérez vos outils exactement dans l'état où ils étaient.",
    photo: "/photos/regle-proximite.jpg",
    alt: "Deux personnes se serrant la main au-dessus d'une table",
  },
];

/* ——— 6 · « Ce que nous faisons » — deux cartes de la section sombre ——— */
const METIERS: { titre: string; texte: string }[] = [
  {
    titre: "Installer",
    texte:
      "On conçoit et on branche le moteur sur vos outils : relance de devis et de factures, réception des demandes clients, classement des factures fournisseurs, réactivation du fichier dormant. Les choix techniques vous sont expliqués et les réglages documentés — vous n'héritez pas d'une boîte noire.",
  },
  {
    titre: "Accompagner",
    texte:
      "On règle les cadences et les circuits au fil de votre activité, on ajoute un second moteur seulement quand le premier a fait ses preuves, et on reste joignable. L'objectif n'est pas de vous rendre dépendant d'une agence : c'est que le système tienne sans nous entre deux ajustements.",
  },
];

export default function AProposPage() {
  return (
    <PageShell>
      {/* couche motion commune : lenis + reveals GSAP */}
      <PageMotion />

      {/* ════════ 1 · HERO SOMBRE CENTRÉ + QUATRE TUILES ════════ */}
      <div className="px-6 pb-16 pt-16 text-center sm:px-10 sm:pb-24 sm:pt-28">
        <h1
          data-reveal
          /* deux lignes comme la référence : le titre est verrouillé par les
             <span block>, la largeur doit donc juste laisser passer la plus
             longue (« automatiser sans embaucher », 26 signes) sans la couper */
          className="mx-auto max-w-[26ch] text-[38px] font-bold leading-[1.03] tracking-[-0.035em] text-white sm:text-[62px] lg:text-[74px]"
        >
          <span className="block">Pegase :</span>
          <span className="block text-balance">automatiser sans embaucher</span>
        </h1>
        <p
