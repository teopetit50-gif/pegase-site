      </div>

      {/* ════════ 2 · « POURQUOI NOUS CHOISIR ? » — TROIS CARTES ════════ */}
      <Fondu vers="clair" />
      <section
        data-monde="clair"
        className="monde-clair px-6 pb-20 pt-20 sm:px-10 sm:pb-28 sm:pt-28"
      >
        <div className="mx-auto max-w-[1120px] text-center">
          <span
            data-reveal
            className="inline-block rounded-full border border-black/10 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-[0.16em]"
            style={{ color: "#8a6519" }}
          >
            Notre parti pris
          </span>
          <h2
            data-intertitre
            className="mx-auto mt-6 max-w-[20ch] text-[30px] font-bold leading-[1.06] tracking-[-0.03em] text-[#0f1013] sm:text-[52px]"
          >
            Pourquoi nous choisir ?
          </h2>
        </div>

        <div className="mx-auto mt-12 grid max-w-[1120px] gap-5 sm:mt-14 sm:gap-6 lg:grid-cols-3">
