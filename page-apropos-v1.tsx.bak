                ) : (
                  <div className="mt-3 text-[19px] font-medium tracking-[-0.01em] text-[#0f1013]">
                    {c.valeur}
                  </div>
                )}
                <p className="mt-4 text-[15px] leading-[1.8] text-[#52555c]">
                  {c.texte}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ════════ 9 · CTA FINAL — GRAND PANNEAU ARRONDI SOMBRE ════════ */}
      <section
        data-monde="clair"
        className="monde-clair px-6 pb-24 sm:px-10 sm:pb-32"
      >
        <div
          data-reveal
          className="relative mx-auto max-w-[1120px] overflow-hidden rounded-[20px] px-7 py-20 text-center sm:px-10 sm:py-24"
          style={{
            background:
              "radial-gradient(70% 110% at 50% 0%, rgba(247,131,32,0.20), transparent 60%), linear-gradient(180deg, #101216, #000)",
          }}
        >
          <h2 className="mx-auto max-w-[18ch] text-[28px] font-bold leading-[1.08] tracking-[-0.03em] text-white sm:text-[46px]">
            Prêt à récupérer votre temps ?
          </h2>
          <p className="mx-auto mt-5 max-w-xl text-[16px] leading-relaxed text-muted sm:text-[17px]">
            Trente minutes pour identifier la difficulté qui vous coûte le
            plus, la chiffrer, et désigner le moteur au meilleur retour sur
            investissement. Gratuit, sans engagement — et parfois la conclusion
            est qu&apos;il n&apos;y a rien à installer.
          </p>
          <div className="mt-9 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
            <Link
              href="/reserver-un-audit"
              className="rounded-[var(--radius-btn)] bg-white px-7 py-3.5 text-[16px] font-semibold text-black transition hover:bg-neutral-200 active:scale-[0.97]"
            >
              Réserver l&apos;audit gratuit
            </Link>
            <a
              href="mailto:contact@pegase.gp"
              className="rounded-[var(--radius-btn)] bg-white/[0.08] px-6 py-3.5 text-[15px] font-medium text-white transition hover:bg-white/[0.14]"
            >
              Écrire directement
            </a>
          </div>
        </div>
      </section>
    </PageShell>
  );
}
