      {/* ════════ 6 · « CE QUE NOUS FAISONS » — SECTION SOMBRE ════════
          Chez hyperstack c'est le seul bloc bleu nuit au milieu du clair ;
          ici c'est le seul bloc noir. Deux cartes, puis un panneau large. */}
      <Fondu vers="sombre" />
      <section className="bg-black px-6 py-20 sm:px-10 sm:py-28">
        <div className="mx-auto max-w-[1120px]">
