const FAQ = [
  {
    q: "Il faut installer les douze moteurs ?",
    a: "Non, et c'est même l'inverse. L'audit sert à désigner celui qui a le meilleur retour chez vous, compte tenu de ce que votre problème n°1 vous coûte. La plupart des installations commencent par un seul moteur ; les suivants s'ajoutent quand le premier a fait ses preuves.",
  },
  {
    q: "Qu'est-ce qui différencie un moteur d'une pépite ?",
    a: "Un moteur défensif ou offensif se branche sur vos outils en quelques jours et traite une tâche récurrente. Une pépite est un produit d'envergure construit pour un secteur ou une échéance réglementaire — facturation électronique, marchés publics, saisonnier, recouvrement. Elle se déploie en plusieurs semaines, avec des jalons que vous validez un par un.",
  },
  {
    q: "Et si je n'ai ni logiciel ni CRM ?",
    a: "C'est justement le principe : mail, tableur et WhatsApp suffisent. Les moteurs sont construits pour travailler sur ces outils-là, tels que vous les tenez déjà. Pas besoin d'acheter un CRM pour commencer.",
  },
  {
    q: "Les messages partent sans moi ?",
    a: "Non. Chaque message s'approuve, se corrige ou se suspend d'un clic. Les premières semaines, tout vous est soumis avant envoi ; ensuite vous choisissez ce qui part seul et ce qui attend votre accord. Les clients que vous excluez ne sont jamais contactés.",
  },
  {
    q: "Où vont mes données ?",
    a: "Nulle part : les moteurs tournent sur une infrastructure auto-hébergée et viennent lire vos données là où elles sont — votre tableur, votre messagerie — au lieu de les copier dans un cloud tiers. Les modèles reçoivent le strict nécessaire à chaque tâche, jamais l'intégralité d'un fichier. Le tout documenté, conforme RGPD.",
  },
];

/* ——— en-tête de section : pastille, titre, chapô, centrés ——— */
function EnTete({
  pastille,
  titre,
  chapo,
  lien,
}: {
  pastille: string;
  titre: string;
  chapo: string;
  lien?: { label: string; href: string };
}) {
  return (
    <div className="flex flex-col items-center text-center">
      <div data-reveal>
        <span className="o-pill">{pastille}</span>
      </div>
      <h2 data-reveal className="o-h2 mt-2.5 max-w-[600px]">
        {titre}
      </h2>
      <p data-reveal className="o-lead mt-4 max-w-[650px]">
        {chapo}
      </p>
      {lien ? (
        <div data-reveal className="mt-5">
          <Link href={lien.href} className="o-link">
            {lien.label}
            <Chevron />
          </Link>
        </div>
      ) : null}
    </div>
  );
}

/* ——— carte moteur de rangée : 343 px, illustration optionnelle ——— */
function CarteMoteur({
  system,
  titre,
  role,
  texte,
  illustration,
}: {
  system: string;
  titre: string;
  role: string;
  texte: string;
  illustration?: React.ReactNode;
}) {
  return (
    <div data-reveal className="o-card-plate flex w-[300px] shrink-0 flex-col px-7 pt-9 sm:w-[343px] sm:px-8 sm:pt-10">
      <div className="flex justify-center">
        <SystemLogo system={system} />
      </div>
      <h3 className="o-h4 mt-5 text-center">{titre}</h3>
      <p className="o-small mt-1 text-center font-medium !text-[#52525b]">{role}</p>
      <p className="o-body mt-3 text-center">{texte}</p>
      <Link
        href={`/offres/${system.toLowerCase()}`}
        className="o-link mx-auto mt-5"
      >
        Voir la fiche
        <Chevron />
      </Link>
      {illustration ? (
        <div className="mt-8 w-full pb-0">{illustration}</div>
      ) : (
        <div className="pb-10" />
      )}
    </div>
  );
}

