                </p>
                <div className="mt-7">
                  <MaqEtapes />
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* ════════ CHIFFRAGE — quatre cartes, sans prix inventé ════════ */}
        <section data-monde="clair" className="o-wrap pb-[110px]">
          <EnTete
            pastille="Chiffrage"
            titre="Ce que ça coûte."
            chapo="Ça dépend du moteur et de votre situation — c'est précisément ce que l'audit chiffre en trente minutes : ce que le problème vous coûte, ce que le moteur coûterait, et le retour attendu."
          />

          {/* le sélecteur de la référence bascule mensuel/annuel ; ici il sert
              de repère de famille et renvoie aux trois sections ci-dessus */}
          <div data-reveal className="mt-9 flex justify-center">
            <div className="o-segments">
              <a href="#familles" className="o-segment" data-actif="true">
                Défensifs
              </a>
              <a href="#familles" className="o-segment">
                Offensifs
              </a>
              <a href="#familles" className="o-segment">
                Pépites
              </a>
            </div>
          </div>

          <div className="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {FORMULES.map((f) => (
              <div
                key={f.famille}
                data-reveal
                className={`o-formule ${f.phare ? "o-formule--phare" : ""}`}
              >
                <div className="flex items-center justify-between gap-2">
                  <span className="o-pill o-pill--xs">{f.famille}</span>
                  {f.phare ? (
                    <span className="rounded-[7px] bg-[#f0fdf4] px-2.5 py-1 text-[11px] font-semibold text-[#15803d]">
                      Le plus demandé
                    </span>
                  ) : null}
                </div>
                <div className="mt-6 flex items-baseline gap-2">
                  <span className="o-h5">Chiffré à l&apos;audit</span>
                </div>
                <p className="o-body mt-3 min-h-[54px] !text-[15px]">{f.accroche}</p>
                <div className="mt-7 space-y-3 border-t border-[var(--o-line)] pt-6">
                  {f.lignes.map(([k, v]) => (
                    <div key={k} className="flex items-center justify-between gap-3">
                      <span className="o-small whitespace-nowrap">{k}</span>
                      <span className="o-small whitespace-nowrap font-semibold !text-[#09090b]">{v}</span>
                    </div>
                  ))}
                </div>
                <Link
                  href="/audit"
                  className="o-btn o-btn--primary mt-8 w-full"
                >
                  Demander l&apos;audit
                </Link>
              </div>
            ))}
          </div>

          <div data-reveal className="mt-10 flex justify-center">
            <Link href="/audit" className="o-link">
              Comment se déroule l&apos;audit
              <Chevron />
            </Link>
          </div>
        </section>

        {/* ════════ FAQ — carte grise centrée ════════ */}
        <section data-monde="clair" className="o-wrap pb-[110px]">
          <div data-reveal className="o-card-plate mx-auto max-w-[800px] px-6 py-14 sm:px-[100px] sm:py-[76px]">
            <h3
              className="o-h4 text-center"
              style={{ fontSize: "36px", lineHeight: "1.4" }}
            >
              Questions directes
            </h3>
            <p className="o-body mt-2.5 text-center">
              Ce qu&apos;on nous demande avant de se lancer — répondu ici.
            </p>
            <div className="mt-9">
              {FAQ.map((f) => (
                <details key={f.q} className="o-faq-item">
                  <summary>
                    {f.q}
                    <span className="o-faq-croix" aria-hidden>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={1.8} strokeLinecap="round">
                        <path d="M12 5v14M5 12h14" />
                      </svg>
                    </span>
                  </summary>
                  <p className="o-body pb-6 pr-10">{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        </section>

        {/* ════════ CTA FINAL ════════ */}
        <section data-monde="clair" className="o-wrap pb-[120px]">
          <div
            data-reveal
            className="relative overflow-hidden rounded-[15px] bg-[#fafafa] px-6 py-16 text-center sm:px-20 sm:py-20"
          >
            <div
              aria-hidden
              className="o-dots o-dots-fade-up pointer-events-none absolute inset-x-0 bottom-0 top-1/2"
            />
            <h2 className="o-h2 relative mx-auto max-w-[1040px]">
              Douze moteurs. Un seul à installer.
            </h2>
            <p className="o-lead relative mx-auto mt-4 max-w-[610px]">
              Trente minutes pour désigner lequel, chiffrer ce qu&apos;il
              rapporte, et vérifier votre éligibilité au Chèque TIC. Sans
              engagement.
            </p>
            <div className="relative mt-8">
              <Link href="/audit" className="o-btn o-btn--primary">
                Audit gratuit
                <Chevron taille={14} />
              </Link>
            </div>
          </div>
        </section>
      </div>
    </PageShell>
  );
}
